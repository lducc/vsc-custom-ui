{
  "vscode_custom_css.imports": [
    "file:///home/lducc/tools/vscode-ui/linux/custom.css",
    "file:///home/lducc/tools/vscode-ui/linux/custom.js"
  ],

  "workbench.colorTheme": "kanagawa-wave",
  "workbench.iconTheme": "material-icon-theme",

  "window.menuBarVisibility": "compact",
  "window.commandCenter": false,
  "window.customTitleBarVisibility": "windowed",
  "window.restoreFullscreen": true,
  "window.zoomLevel": -0.25,

  "workbench.navigationControl.enabled": false,
  "workbench.layoutControl.enabled": false,

  "workbench.experimental.modernUI": true,
  "workbench.experimental.modernUIEditorTabStyle": "connected",
  "window.density.editorTabHeight": "compact",

  "workbench.activityBar.compact": true,
  "workbench.sideBar.location": "right",
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  "workbench.editor.enablePreview": false,
  "workbench.editor.tabSizing": "shrink",
  "workbench.editor.tabActionReserveSpace": false,
  "workbench.tree.indent": 11,
  "explorer.openEditors.visible": 0,
  "editor.wordWrap": "on",
  "editor.fontFamily": "'Maple Mono NF', 'JetBrains Mono', monospace",
  "editor.fontSize": 16,
  "editor.lineHeight": 23,
  "editor.fontWeight": "350",
  "editor.fontLigatures": true,

  "editor.padding.top": 6,
  "editor.padding.bottom": 6,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.renderLineHighlight": "gutter",

  "editor.guides.bracketPairs": "active",
  "editor.renderWhitespace": "selection",
  "editor.minimap.enabled": false,

  "editor.scrollbar.verticalScrollbarSize": 4,
  "editor.scrollbar.horizontalScrollbarSize": 4,

  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.fontWeight": "500",
  "terminal.integrated.smoothScrolling": true,

  "debug.console.fontFamily": "'Maple Mono NF', 'JetBrains Mono', monospace",
  "debug.console.fontSize": 14,

  "markdown.preview.fontFamily": "Inter, sans-serif",
  "markdown.preview.fontSize": 14,

  "chat.commandCenter.enabled": false,
  "chat.agentsControl.enabled": false,

  "explorer.confirmPasteNative": false
}
